# ==============================================================================
# Indian AI Paper Trading Platform - Environment Configuration Template
# ==============================================================================
# NOTE: Never commit sensitive credentials or real demat API keys.
# This file is a template. Copy to .env for local configuration.

# Application Environment (development, testing, production)
APP_ENV=development
APP_LOG_LEVEL=INFO

# Application Execution Mode (MUST be paper for this system)
# REAL TRADING IS STRICTLY DISABLED IN THIS CODEBASE.
APP_MODE=paper

# SQLite Database Location
DATABASE_URL=sqlite:///data/storage/paper_trader.db

# Market Data Provider supported by the current resolver: yfinance or csv.
# yfinance is a research source, not a guaranteed licensed real-time NSE feed.
DATA_PROVIDER=yfinance

# Angel One SmartAPI Credentials (FREE Market Data & WebSockets)
# Get your API key at https://smartapi.angelbroking.com
# STRICT READ-ONLY USAGE: Northstar never executes live orders through SmartAPI.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# Dhan Credentials (Optional - Note: Dhan Data APIs cost ₹499+GST/mo)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# TrueData Credentials (Optional - Required only if licensed TrueData feed is active)
# Leave blank when using csv or synthetic market data.
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_REALTIME_URL=wss://push.truedata.in
TRUEDATA_HISTORICAL_URL=https://history.truedata.in

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# System Kill Switch State (true = all new orders blocked)
KILL_SWITCH_ACTIVE=false

# API Security (Token authentication for mutating actions & WebSockets)
# When set, mutating REST endpoints & WebSockets require this token.
# Leave blank for open local development on 127.0.0.1.
NORTHSTAR_API_TOKEN=


# ==============================================================================
# Local Specialist Financial AI Runtime (Fin-R1 GGUF)
# ==============================================================================
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=fin-r1:7b-q4_k_m
LOCAL_AI_CONTEXT_SIZE=4096
LOCAL_AI_TIMEOUT_SECONDS=120
LOCAL_AI_MAX_CONCURRENT_REQUESTS=1
LOCAL_AI_TEMPERATURE=0.1
LOCAL_AI_TOP_P=0.95
LOCAL_AI_ENABLED=true
LOCAL_AI_DEVICE=cuda
LOCAL_AI_GPU_LAYERS=33
