# ==============================================================================
# Indian AI Paper Trading Platform - Environment Configuration Template
# ==============================================================================
# NOTE: Never commit sensitive credentials or real demat API keys.
# This file is a template. Copy to .env for local configuration.

# Application Environment (development, testing, production)
APP_ENV=development
APP_LOG_LEVEL=INFO

# Application Execution Mode (MUST be paper for this system)
# REAL TRADING IS STRICTLY DISABLED IN THIS CODEBASE.
APP_MODE=paper

# SQLite Database Location
DATABASE_URL=sqlite:///data/storage/paper_trader.db

# Market Data Provider (csv, synthetic, truedata)
DATA_PROVIDER=synthetic

# TrueData Credentials (Optional - Required only if licensed TrueData feed is active)
# Leave blank when using csv or synthetic market data.
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_REALTIME_URL=wss://push.truedata.in
TRUEDATA_HISTORICAL_URL=https://history.truedata.in

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# System Kill Switch State (true = all new orders blocked)
KILL_SWITCH_ACTIVE=false

