# Python virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
*.env
!.env.example

# Python build, distribution & egg metadata
build/
dist/
*.egg-info/
*.egg

# Bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases and local storage
*.sqlite
*.sqlite3
*.db
data/cache/*
!data/cache/.gitkeep
data/live/*
!data/live/.gitkeep
data/storage/*
!data/storage/.gitkeep

# Model files & weights
models/saved/*
!models/saved/.gitkeep
models/registry.json
*.joblib
*.pkl

# Runtime states and locks
config/*.state
config/kill_switch.state
*.pid
*.lock

# Logs and runtime artifacts
logs/*
!logs/.gitkeep
*.log

# Reports and temporary outputs
reports/runs/*
!reports/runs/.gitkeep
reports/exports/*
!reports/exports/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
